@header '''\
/* Generated from language/ribos/grammar/parser.gram. Do not edit this file. */
#include "parser_internal.h"
'''
@trailer '''\
RibosAstNode *
ribos_generated_parse(Parser *p)
{
    p->keywords = reserved_keywords;
    p->n_keyword_lists = n_keyword_lists;
    p->soft_keywords = soft_keywords;
    return start_rule(p);
}
'''

start[RibosAstNode *]:
    | !invalid_reserved_keyword newlines? declarations=declaration* ENDMARKER {
        ribos_parser_finish(p, declarations)
      }

declaration[RibosAstNode *]:
    | decorators=decorator* value=function_decl newlines? {
        ribos_ast_decorated(p, value, decorators)
      }
    | decorators=decorator* value=struct_decl newlines? {
        ribos_ast_decorated(p, value, decorators)
      }
    | decorators=decorator* value=enum_decl newlines? {
        ribos_ast_decorated(p, value, decorators)
      }

decorator[RibosAstNode *]:
    | at='@' name=dotted_name args=decorator_arguments? NEWLINE {
        ribos_ast_make(
            p, RIBOS_AST_DECORATOR, at, name, NULL, NULL,
            (asdl_seq *)args, NULL, 0)
      }

decorator_arguments[asdl_seq *]:
    | '(' args=attribute_arguments? ')' { (asdl_seq *)args }

attribute_arguments[asdl_seq *]:
    | args=','.attribute_argument+ ','? { args }

attribute_argument[RibosAstNode *]:
    | name=NAME '=' value=constant_expression {
        ribos_ast_make(
            p, RIBOS_AST_ATTRIBUTE_ARGUMENT, name, value, NULL, NULL,
            NULL, NULL, 0)
      }

function_decl[RibosAstNode *]:
    | 'def' name=NAME '(' params=parameters? ')' '->' result=type_expr body=block {
        ribos_ast_make(
            p, RIBOS_AST_FUNCTION, name, result, body, NULL,
            (asdl_seq *)params, NULL, 0)
      }

parameters[asdl_seq *]:
    | values=','.parameter+ ','? { values }

parameter[RibosAstNode *]:
    | name=NAME ':' type=type_expr {
        ribos_ast_make(
            p, RIBOS_AST_PARAMETER, name, type, NULL, NULL,
            NULL, NULL, 0)
      }

struct_decl[RibosAstNode *]:
    | 'struct' name=NAME '{' newlines? fields=struct_field* '}' {
        ribos_ast_make(
            p, RIBOS_AST_STRUCT, name, NULL, NULL, NULL,
            fields, NULL, 0)
      }

struct_field[RibosAstNode *]:
    | name=NAME ':' type=type_expr NEWLINE newlines? {
        ribos_ast_make(
            p, RIBOS_AST_FIELD, name, type, NULL, NULL,
            NULL, NULL, 0)
      }

enum_decl[RibosAstNode *]:
    | 'enum' name=NAME '{' newlines? variants=enum_variant* '}' {
        ribos_ast_make(
            p, RIBOS_AST_ENUM, name, NULL, NULL, NULL,
            variants, NULL, 0)
      }

enum_variant[RibosAstNode *]:
    | name=NAME payload=variant_payload? NEWLINE newlines? {
        ribos_ast_make(
            p, RIBOS_AST_VARIANT, name, NULL, NULL, NULL,
            (asdl_seq *)payload, NULL, 0)
      }

variant_payload[asdl_seq *]:
    | '(' values=type_list? ')' { (asdl_seq *)values }

type_list[asdl_seq *]:
    | values=','.type_expr+ ','? { values }

block[RibosAstNode *]:
    | brace='{' newlines? statements=statement* '}' {
        ribos_ast_make(
            p, RIBOS_AST_BLOCK, brace, NULL, NULL, NULL,
            statements, NULL, 0)
      }

statement[RibosAstNode *]:
    | value=if_stmt newlines? { value }
    | value=for_stmt newlines? { value }
    | value=match_stmt newlines? { value }
    | value=simple_stmt NEWLINE { value }

simple_stmt[RibosAstNode *]:
    | let_stmt
    | return_stmt
    | assignment
    | expression

let_stmt[RibosAstNode *]:
    | 'let' mutable='mut'? name=NAME annotation=type_annotation? '=' value=expression {
        ribos_ast_make(
            p, RIBOS_AST_LET, name, (RibosAstNode *)annotation, value, NULL,
            NULL, NULL, mutable != NULL)
      }

type_annotation[RibosAstNode *]:
    | ':' value=type_expr { value }

return_stmt[RibosAstNode *]:
    | keyword='return' value=expression? {
        ribos_ast_make(
            p, RIBOS_AST_RETURN, keyword, (RibosAstNode *)value, NULL, NULL,
            NULL, NULL, 0)
      }

assignment[RibosAstNode *]:
    | target=postfix equals='=' value=expression {
        ribos_ast_make(
            p, RIBOS_AST_ASSIGN, equals, target, value, NULL,
            NULL, NULL, 0)
      }

if_stmt[RibosAstNode *]:
    | keyword='if' condition=expression consequence=block alternative=else_clause? {
        ribos_ast_make(
            p, RIBOS_AST_IF, keyword, condition, consequence,
            (RibosAstNode *)alternative, NULL, NULL, 0)
      }

else_clause[RibosAstNode *]:
    | newlines? 'else' value=if_stmt { value }
    | newlines? 'else' value=block { value }

for_stmt[RibosAstNode *]:
    | 'for' name=NAME 'in' iterable=expression body=block {
        ribos_ast_make(
            p, RIBOS_AST_FOR, name, iterable, body, NULL,
            NULL, NULL, 0)
      }

match_stmt[RibosAstNode *]:
    | keyword='match' value=expression '{' newlines? arms=match_arm+ '}' {
        ribos_ast_make(
            p, RIBOS_AST_MATCH, keyword, value, NULL, NULL,
            arms, NULL, 0)
      }

match_arm[RibosAstNode *]:
    | pattern=pattern '=>' body=block newlines? {
        ribos_ast_make(
            p, RIBOS_AST_MATCH_ARM, NULL, pattern, body, NULL,
            NULL, NULL, 0)
      }

pattern[RibosAstNode *]:
    | underscore='_' {
        ribos_ast_make(
            p, RIBOS_AST_PATTERN, underscore, NULL, NULL, NULL,
            NULL, NULL, 1)
      }
    | name=dotted_name '(' args=pattern_arguments? ')' {
        ribos_ast_make(
            p, RIBOS_AST_PATTERN, NULL, name, NULL, NULL,
            (asdl_seq *)args, NULL, 2)
      }
    | value=literal {
        ribos_ast_make(
            p, RIBOS_AST_PATTERN, NULL, value, NULL, NULL,
            NULL, NULL, 3)
      }
    | name=dotted_name {
        ribos_ast_make(
            p, RIBOS_AST_PATTERN, NULL, name, NULL, NULL,
            NULL, NULL, 4)
      }

pattern_arguments[asdl_seq *]:
    | values=','.pattern_argument+ ','? { values }

pattern_argument[RibosAstNode *]:
    | name=NAME {
        ribos_ast_make(
            p, RIBOS_AST_PATH, name, NULL, NULL, NULL,
            NULL, NULL, 0)
      }
    | underscore='_' {
        ribos_ast_make(
            p, RIBOS_AST_PATTERN, underscore, NULL, NULL, NULL,
            NULL, NULL, 1)
      }

expression[RibosAstNode *]:
    | if_expr
    | disjunction

if_expr[RibosAstNode *]:
    | keyword='if' condition=disjunction consequence=value_block 'else' alternative=value_block {
        ribos_ast_make(
            p, RIBOS_AST_IF_EXPRESSION, keyword, condition, consequence,
            alternative, NULL, NULL, 0)
      }

value_block[RibosAstNode *]:
    | '{' newlines? value=expression newlines? '}' { value }

disjunction[RibosAstNode *]:
    | first=conjunction rest=or_tail* {
        ribos_ast_fold_binary(p, first, rest)
      }

or_tail[RibosAstNode *]:
    | operator='or' right=conjunction {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_OR, operator, right)
      }

conjunction[RibosAstNode *]:
    | first=inversion rest=and_tail* {
        ribos_ast_fold_binary(p, first, rest)
      }

and_tail[RibosAstNode *]:
    | operator='and' right=inversion {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_AND, operator, right)
      }

inversion[RibosAstNode *]:
    | operator='not' value=inversion {
        ribos_ast_make(
            p, RIBOS_AST_UNARY, operator, value, NULL, NULL,
            NULL, NULL, RIBOS_OPERATOR_NOT)
      }
    | comparison

comparison[RibosAstNode *]:
    | left=bitwise_or tail=compare_tail? {
        ribos_ast_fold_binary(
            p, left, ribos_ast_singleton_sequence(p, (RibosAstNode *)tail))
      }

compare_tail[RibosAstNode *]:
    | operator='==' right=bitwise_or {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_EQUAL, operator, right)
      }
    | operator='!=' right=bitwise_or {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_NOT_EQUAL, operator, right)
      }
    | operator='<' right=bitwise_or {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_LESS, operator, right)
      }
    | operator='<=' right=bitwise_or {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_LESS_EQUAL, operator, right)
      }
    | operator='>' right=bitwise_or {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_GREATER, operator, right)
      }
    | operator='>=' right=bitwise_or {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_GREATER_EQUAL, operator, right)
      }
    | operator='in' right=bitwise_or {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_IN, operator, right)
      }
    | operator='not' 'in' right=bitwise_or {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_NOT_IN, operator, right)
      }

bitwise_or[RibosAstNode *]:
    | first=bitwise_xor rest=bitwise_or_tail* {
        ribos_ast_fold_binary(p, first, rest)
      }

bitwise_or_tail[RibosAstNode *]:
    | operator='|' right=bitwise_xor {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_BIT_OR, operator, right)
      }

bitwise_xor[RibosAstNode *]:
    | first=bitwise_and rest=bitwise_xor_tail* {
        ribos_ast_fold_binary(p, first, rest)
      }

bitwise_xor_tail[RibosAstNode *]:
    | operator='^' right=bitwise_and {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_BIT_XOR, operator, right)
      }

bitwise_and[RibosAstNode *]:
    | first=shift rest=bitwise_and_tail* {
        ribos_ast_fold_binary(p, first, rest)
      }

bitwise_and_tail[RibosAstNode *]:
    | operator='&' right=shift {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_BIT_AND, operator, right)
      }

shift[RibosAstNode *]:
    | first=sum rest=shift_tail* {
        ribos_ast_fold_binary(p, first, rest)
      }

shift_tail[RibosAstNode *]:
    | operator='<<' right=sum {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_SHIFT_LEFT, operator, right)
      }
    | operator='>>' right=sum {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_SHIFT_RIGHT, operator, right)
      }

sum[RibosAstNode *]:
    | first=term rest=sum_tail* {
        ribos_ast_fold_binary(p, first, rest)
      }

sum_tail[RibosAstNode *]:
    | operator='+' right=term {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_ADD, operator, right)
      }
    | operator='-' right=term {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_SUBTRACT, operator, right)
      }

term[RibosAstNode *]:
    | first=factor rest=term_tail* {
        ribos_ast_fold_binary(p, first, rest)
      }

term_tail[RibosAstNode *]:
    | operator='*' right=factor {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_MULTIPLY, operator, right)
      }
    | operator='/' right=factor {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_DIVIDE, operator, right)
      }
    | operator='%' right=factor {
        ribos_ast_binary_tail(p, RIBOS_OPERATOR_REMAINDER, operator, right)
      }

factor[RibosAstNode *]:
    | operator='+' value=factor {
        ribos_ast_make(
            p, RIBOS_AST_UNARY, operator, value, NULL, NULL,
            NULL, NULL, RIBOS_OPERATOR_POSITIVE)
      }
    | operator='-' value=factor {
        ribos_ast_make(
            p, RIBOS_AST_UNARY, operator, value, NULL, NULL,
            NULL, NULL, RIBOS_OPERATOR_NEGATIVE)
      }
    | operator='~' value=factor {
        ribos_ast_make(
            p, RIBOS_AST_UNARY, operator, value, NULL, NULL,
            NULL, NULL, RIBOS_OPERATOR_BIT_NOT)
      }
    | postfix

postfix[RibosAstNode *]:
    | base=atom trailers=trailer* {
        ribos_ast_apply_trailers(p, base, trailers)
      }

trailer[RibosAstNode *]:
    | token='(' args=arguments? ')' {
        ribos_ast_make(
            p, RIBOS_AST_CALL, token, NULL, NULL, NULL,
            (asdl_seq *)args, NULL, 0)
      }
    | '.' name=NAME {
        ribos_ast_make(
            p, RIBOS_AST_MEMBER, name, NULL, NULL, NULL,
            NULL, NULL, 0)
      }
    | token='[' index=expression ']' {
        ribos_ast_make(
            p, RIBOS_AST_INDEX, token, NULL, index, NULL,
            NULL, NULL, 0)
      }
    | token='?' {
        ribos_ast_make(
            p, RIBOS_AST_PROPAGATE, token, NULL, NULL, NULL,
            NULL, NULL, 0)
      }

arguments[asdl_seq *]:
    | values=','.argument+ ','? { values }

argument[RibosAstNode *]:
    | name=NAME '=' value=expression {
        ribos_ast_make(
            p, RIBOS_AST_ARGUMENT, name, value, NULL, NULL,
            NULL, NULL, 1)
      }
    | value=expression {
        ribos_ast_make(
            p, RIBOS_AST_ARGUMENT, NULL, value, NULL, NULL,
            NULL, NULL, 0)
      }

atom[RibosAstNode *]:
    | literal
    | '(' value=expression ')' { value }
    | list_literal
    | map_literal
    | dotted_name

literal[RibosAstNode *]:
    | value=NUMBER {
        ribos_ast_literal(p, RIBOS_AST_INTEGER, value)
      }
    | value=STRING {
        ribos_ast_literal(p, RIBOS_AST_STRING, value)
      }
    | value='True' {
        ribos_ast_literal(p, RIBOS_AST_BOOLEAN, value)
      }
    | value='False' {
        ribos_ast_literal(p, RIBOS_AST_BOOLEAN, value)
      }
    | value='None' {
        ribos_ast_literal(p, RIBOS_AST_NONE, value)
      }

list_literal[RibosAstNode *]:
    | token='[' values=expressions? ']' {
        ribos_ast_make(
            p, RIBOS_AST_LIST, token, NULL, NULL, NULL,
            (asdl_seq *)values, NULL, 0)
      }

expressions[asdl_seq *]:
    | values=','.expression+ ','? { values }

map_literal[RibosAstNode *]:
    | token='{' newlines? entries=map_entries? newlines? '}' {
        ribos_ast_make(
            p, RIBOS_AST_MAP, token, NULL, NULL, NULL,
            (asdl_seq *)entries, NULL, 0)
      }

map_entries[asdl_seq *]:
    | values=','.map_entry+ ','? { values }

map_entry[RibosAstNode *]:
    | key=expression ':' value=expression {
        ribos_ast_make(
            p, RIBOS_AST_MAP_ENTRY, NULL, key, value, NULL,
            NULL, NULL, 0)
      }

constant_expression[RibosAstNode *]:
    | value=expression { value }

type_expr[RibosAstNode *]:
    | name=dotted_name args=type_arguments_group? {
        ribos_ast_make(
            p, RIBOS_AST_TYPE, NULL, name, NULL, NULL,
            (asdl_seq *)args, NULL, 0)
      }

type_arguments_group[asdl_seq *]:
    | '[' values=type_arguments ']' { values }

type_arguments[asdl_seq *]:
    | values=','.type_argument+ ','? { values }

type_argument[RibosAstNode *]:
    | type_expr
    | value=NUMBER {
        ribos_ast_literal(p, RIBOS_AST_INTEGER, value)
      }

dotted_name[RibosAstNode *]:
    | first=NAME rest=dotted_name_tail* {
        ribos_ast_path(p, first, rest)
      }

dotted_name_tail[Token *]:
    | '.' value=NAME { value }

newlines:
    | NEWLINE+

# This rule deliberately remains unreachable. Its literals reserve spellings
# and let the host diagnostic identify forbidden language features.
invalid_reserved_keyword:
    | 'as'
    | 'async'
    | 'await'
    | 'break'
    | 'catch'
    | 'class'
    | 'continue'
    | 'defer'
    | 'except'
    | 'finally'
    | 'from'
    | 'import'
    | 'lambda'
    | 'raise'
    | 'throw'
    | 'trait'
    | 'try'
    | 'while'
    | 'with'
    | 'yield'
