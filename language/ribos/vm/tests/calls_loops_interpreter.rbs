@pure
def increment(value: u32) -> u32 {
    return value + 1
}

@pure
def increment_twice(value: u32) -> u32 {
    let once = increment(value)
    return increment(once)
}

@policy(
    capabilities=[
        Capability.BOOT,
    ],
    instruction_budget=4096,
    helper_budget=2,
)
def boot(ctx: BootContext) -> Result[BootAction, BootError] {
    let seed: u32 = 4
    let incremented = increment_twice(seed)
    let values: Array[u32, 2] = [
        1,
        2,
    ]
    let mut accumulator = incremented

    for outer in values {
        for inner in values {
            accumulator = accumulator + outer + inner
        }
    }

    if accumulator >= incremented {
        return Ok(boot.recovery(RecoveryReason.REQUESTED))
    } else {
        return Err(BootError.INVALID_IMAGE)
    }
}
