@header '''\
/* Generated from language/grammar/ribos.gram. Do not edit this file. */
#include "ribos_parser_internal.h"
'''
@trailer '''\
RibosParseSummary *
ribos_generated_parse(Parser *p)
{
    p->keywords = reserved_keywords;
    p->n_keyword_lists = n_keyword_lists;
    p->soft_keywords = soft_keywords;
    return start_rule(p);
}
'''

start[RibosParseSummary *]:
    | !invalid_reserved_keyword newlines? declarations=declaration* ENDMARKER {
        ribos_parser_finish(p, declarations)
      }

declaration:
    | decorator* function_decl newlines?
    | decorator* struct_decl newlines?
    | decorator* enum_decl newlines?

decorator:
    | '@' dotted_name ('(' attribute_arguments? ')')? NEWLINE

attribute_arguments:
    | attribute_argument (',' attribute_argument)* ','?

attribute_argument:
    | NAME '=' constant_expression

function_decl:
    | 'def' NAME '(' parameters? ')' '->' type_expr block

parameters:
    | parameter (',' parameter)* ','?

parameter:
    | NAME ':' type_expr

struct_decl:
    | 'struct' NAME '{' newlines? struct_field* '}'

struct_field:
    | NAME ':' type_expr NEWLINE newlines?

enum_decl:
    | 'enum' NAME '{' newlines? enum_variant* '}'

enum_variant:
    | NAME ('(' type_list? ')')? NEWLINE newlines?

type_list:
    | type_expr (',' type_expr)* ','?

block:
    | '{' newlines? statement* '}'

statement:
    | if_stmt newlines?
    | for_stmt newlines?
    | match_stmt newlines?
    | simple_stmt NEWLINE

simple_stmt:
    | let_stmt
    | return_stmt
    | assignment
    | expression

let_stmt:
    | 'let' 'mut'? NAME (':' type_expr)? '=' expression

return_stmt:
    | 'return' expression?

assignment:
    | postfix '=' expression

if_stmt:
    | 'if' expression block (newlines? 'else' (if_stmt | block))?

for_stmt:
    | 'for' NAME 'in' expression block

match_stmt:
    | 'match' expression '{' newlines? match_arm (newlines? match_arm)* newlines? '}'

match_arm:
    | pattern '=>' block

pattern:
    | dotted_name '(' pattern_arguments? ')'
    | '_'
    | literal
    | dotted_name

pattern_arguments:
    | pattern_argument (',' pattern_argument)* ','?

pattern_argument:
    | NAME
    | '_'

expression:
    | if_expr
    | disjunction

if_expr:
    | 'if' disjunction value_block 'else' value_block

value_block:
    | '{' newlines? expression newlines? '}'

disjunction:
    | conjunction ('or' conjunction)*

conjunction:
    | inversion ('and' inversion)*

inversion:
    | 'not' inversion
    | comparison

comparison:
    | bitwise_or (compare_op bitwise_or)?

compare_op:
    | '=='
    | '!='
    | '<'
    | '<='
    | '>'
    | '>='
    | 'in'
    | 'not' 'in'

bitwise_or:
    | bitwise_xor ('|' bitwise_xor)*

bitwise_xor:
    | bitwise_and ('^' bitwise_and)*

bitwise_and:
    | shift ('&' shift)*

shift:
    | sum (('<<' | '>>') sum)*

sum:
    | term (('+' | '-') term)*

term:
    | factor (('*' | '/' | '%') factor)*

factor:
    | ('+' | '-' | '~') factor
    | postfix

postfix:
    | atom trailer*

trailer:
    | '(' arguments? ')'
    | '.' NAME
    | '[' expression ']'
    | '?'

arguments:
    | argument (',' argument)* ','?

argument:
    | NAME '=' expression
    | expression

atom:
    | literal
    | '(' expression ')'
    | list_literal
    | map_literal
    | dotted_name

literal:
    | NUMBER
    | STRING
    | 'True'
    | 'False'
    | 'None'

list_literal:
    | '[' expressions? ']'

expressions:
    | expression (',' expression)* ','?

map_literal:
    | '{' newlines? map_entries? newlines? '}'

map_entries:
    | map_entry (',' map_entry)* ','?

map_entry:
    | expression ':' expression

constant_expression:
    | expression

type_expr:
    | dotted_name ('[' type_arguments ']')?

type_arguments:
    | type_argument (',' type_argument)* ','?

type_argument:
    | type_expr
    | NUMBER

dotted_name:
    | NAME ('.' NAME)*

newlines:
    | NEWLINE+

# This rule deliberately remains unreachable. Its literals reserve spellings
# and let the host diagnostic identify forbidden language features.
invalid_reserved_keyword:
    | 'as'
    | 'async'
    | 'await'
    | 'break'
    | 'catch'
    | 'class'
    | 'continue'
    | 'defer'
    | 'except'
    | 'finally'
    | 'from'
    | 'import'
    | 'lambda'
    | 'raise'
    | 'throw'
    | 'trait'
    | 'try'
    | 'while'
    | 'with'
    | 'yield'
