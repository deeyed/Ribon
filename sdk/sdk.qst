qstar.custom_target "ribon_sdk_install" {
  toolset = "//qstar/policies:host",
  inputs = {
    "Makefile",
    "tools/install_sdk.py",
  },
  outputs = {
    qstar.output("build/qstar/generated/r5/sdk/install/share/ribon/sdk-manifest.json"),
  },
  command = qstar.cli {
    "make",
    "--no-print-directory",
    "BUILD_ROOT=build/qstar/generated/r5",
    "SDK_INSTALL_ROOT=build/qstar/generated/r5/sdk/install",
    "sdk-install",
  },
  description = qstar.status("Staging Ribon SDK"),
}

qstar.custom_target "ribon_external_plugin_contract" {
  toolset = "//qstar/policies:host",
  inputs = {
    "Makefile",
    "examples/plugins/diagnostic-sink/package.json",
    "examples/plugins/diagnostic-sink/plugin.qst",
  },
  outputs = {
    qstar.output(
      "build/qstar/generated/r5/sdk/examples/diagnostic-sink/external-diagnostic-sink-contract"
    ),
  },
  command = qstar.cli {
    "make",
    "--no-print-directory",
    "BUILD_ROOT=build/qstar/generated/r5",
    "check-external-plugin",
  },
  description = qstar.status("Building external Ribon plugin contract"),
}

qstar.custom_target "ribon_ribos_extension_sdk_contract" {
  toolset = "//qstar/policies:host",
  inputs = {
    "Makefile",
    "include/Ribon/policy/ribos_extension.h",
    "examples/ribos-extension/package.json",
    "examples/ribos-extension/product.json",
    "examples/ribos-extension/extension.c",
    "examples/ribos-extension/contract.c",
    "examples/ribos-extension/policy.rbs",
  },
  outputs = {
    qstar.output(
      "build/qstar/generated/r5/sdk/examples/ribos-extension/contract"
    ),
  },
  command = qstar.cli {
    "make",
    "--no-print-directory",
    "BUILD_ROOT=build/qstar/generated/r5",
    "check-ribos-extension-sdk",
  },
  description = qstar.status("Building installed Ribos extension SDK contract"),
}

qstar.custom_target "ribon_sdk_deployment_consumer" {
  toolset = "//qstar/policies:host",
  inputs = {
    "Makefile",
    "tools/install_sdk.py",
    "tools/check_sdk_deployment_consumer.py",
    "tools/update_manifest.py",
    "sdk/templates/deployment-consumer/README.md",
    "sdk/templates/deployment-consumer/main.c",
    "sdk/templates/deployment-consumer/policy.rbs",
    "sdk/templates/deployment-consumer/product.json",
  },
  outputs = {
    qstar.output(
      "build/qstar/generated/d08/sdk/examples/deployment-consumer/results/consumer.json"
    ),
  },
  command = qstar.cli {
    "make",
    "--no-print-directory",
    "BUILD_ROOT=build/qstar/generated/d08",
    "check-sdk-deployment-consumer",
  },
  description = qstar.status("Building installed-only recovery/update SDK consumer"),
}

qstar.group "ribon_sdk_products" {
  deps = {
    ":ribon_sdk_install",
    ":ribon_external_plugin_contract",
    ":ribon_ribos_extension_sdk_contract",
    ":ribon_sdk_deployment_consumer",
  },
}
