qstar.staticlib "libribon_sdk" {
  artifact_name = "libribon-sdk.a",
  sources = {
    "src/plugins/sdk.c",
    "src/firmware/personality.c",
  },
  deps = {
    "//src/core:libribon_core",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "libribon_policy_ribos" {
  artifact_name = "libribon-policy-ribos.a",
  sources = {
    "src/plugins/policy/ribos/adapter.c",
  },
  deps = {
    "//src/common:libribon_boot",
    "//src/core:libribon_core",
    "//src/security:libribon_security_key_policy",
    "//src/security:libribon_security_protected_state",
  },
  configs = {
    "//qstar/policies:ribon_ribos_target_c",
  },
}

qstar.staticlib "libribon_security_ed25519" {
  artifact_name = "libribon-security-ed25519.a",
  sources = {
    "src/plugins/security/ed25519/provider.c",
    "third_party/monocypher/4.0.3/monocypher.c",
    "third_party/monocypher/4.0.3/monocypher-ed25519.c",
  },
  deps = {
    "//src/security:libribon_security_signature",
  },
  configs = {
    "//qstar/policies:ribon_security_ed25519_c",
  },
}
