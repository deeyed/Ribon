qstar.staticlib "ribon_protocol_synthetic" {
  sources = {
    "src/protocols/synthetic/protocol.c",
  },
  deps = {
    "//src/common:libribon_boot",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "ribon_protocol_luca" {
  sources = {
    "src/protocols/os/luca/protocol.c",
    "src/protocols/os/luca/rlh1_builder.c",
    "src/protocols/os/luca/rlh1_parser.c",
  },
  deps = {
    "//src/common:libribon_boot",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "ribon_protocol_linux" {
  sources = {
    "src/protocols/os/linux/fdt.c",
    "src/protocols/os/linux/protocol.c",
  },
  deps = {
    "//src/common:libribon_boot",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "ribon_protocol_freebsd" {
  sources = {
    "src/protocols/os/freebsd/protocol.c",
  },
  deps = {
    "//src/common:libribon_boot",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "ribon_protocol_zircon" {
  sources = {
    "src/protocols/os/zircon/protocol.c",
  },
  deps = {
    "//src/common:libribon_boot",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.group "ribon_protocol_plugins" {
  deps = {
    "//src/protocols:ribon_protocol_synthetic",
    "//src/protocols:ribon_protocol_luca",
    "//src/protocols:ribon_protocol_linux",
    "//src/protocols:ribon_protocol_freebsd",
    "//src/protocols:ribon_protocol_zircon",
  },
}
