local architectures = {
  "x86_64",
  "aarch64",
  "riscv64",
}

for _, architecture in ipairs(architectures) do
  qstar.staticlib("ribon_arch_" .. architecture) {
    sources = {
      "src/arch/common.c",
      qstar.join("src/arch", architecture, "arch.c"),
    },
    configs = {
      "//qstar/policies:ribon_host_c",
    },
  }
end

qstar.group "ribon_architectures" {
  deps = {
    "//src/arch:ribon_arch_x86_64",
    "//src/arch:ribon_arch_aarch64",
    "//src/arch:ribon_arch_riscv64",
  },
}
