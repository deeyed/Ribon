qstar.staticlib "libribon_update_manifest" {
  artifact_name = "libribon-update-manifest.a",
  sources = {
    "src/update/manifest.c",
  },
  deps = {
    "//src/security:libribon_security_key_policy",
    "//src/security:libribon_security_sha256",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "libribon_update_storage" {
  artifact_name = "libribon-update-storage.a",
  sources = {
    "src/update/storage.c",
  },
  deps = {
    "//src/update:libribon_update_manifest",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "libribon_update_installer" {
  artifact_name = "libribon-update-installer.a",
  sources = {
    "src/update/installer.c",
  },
  deps = {
    "//src/update:libribon_update_storage",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "libribon_update_transaction" {
  artifact_name = "libribon-update-transaction.a",
  sources = {
    "src/update/transaction.c",
  },
  deps = {
    "//src/update:libribon_update_installer",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}

qstar.staticlib "libribon_update_confirmation" {
  artifact_name = "libribon-update-confirmation.a",
  sources = {
    "src/update/confirmation.c",
  },
  deps = {
    "//src/common:libribon_boot",
    "//src/security:libribon_security_key_policy",
    "//src/security:libribon_security_protected_state",
    "//src/update:libribon_update_transaction",
  },
  configs = {
    "//qstar/policies:ribon_host_c",
  },
}
