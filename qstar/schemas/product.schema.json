{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ribon.dev/schema/product-v1.json",
  "title": "Ribon product composition v1",
  "type": "object",
  "required": [
    "schema_version",
    "product_id",
    "product_kind",
    "target_id",
    "architecture",
    "mode",
    "boot_protocols",
    "policies",
    "image",
    "evidence",
    "max_plugins",
    "services",
    "service_selections",
    "plugin_selections",
    "required_capabilities",
    "allowed_capabilities",
    "limits",
    "plugins"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "product_id": {"type": "string", "minLength": 1},
    "product_kind": {"enum": ["library", "bootloader", "firmware"]},
    "target_id": {"type": "string", "minLength": 1},
    "architecture": {"enum": ["selected", "x86_64", "aarch64", "riscv64"]},
    "environment": {"type": "string", "minLength": 1},
    "firmware_personality": {"type": "string", "minLength": 1},
    "port": {"type": "string", "minLength": 1},
    "mode": {"enum": ["normal", "recovery", "provisioning", "diagnostic"]},
    "boot_protocols": {"type": "array", "items": {"type": "string"}},
    "policies": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "image": {"$ref": "image-v1.json"},
    "evidence": {"type": "object"},
    "payload": {
      "type": "object",
      "required": [
        "architecture",
        "class",
        "entry_abi",
        "format",
        "load_base",
        "load_size"
      ],
      "properties": {
        "architecture": {"enum": ["x86_64", "aarch64", "riscv64"]},
        "class": {"const": "external-kernel"},
        "entry_abi": {"type": "string", "minLength": 1},
        "format": {"const": "elf64"},
        "load_base": {"type": "integer", "minimum": 1},
        "load_size": {"type": "integer", "minimum": 1}
      }
    },
    "boot_module_bundle": {
      "type": "object",
      "required": [
        "component_manifest_schema",
        "maximum_modules",
        "provider"
      ],
      "additionalProperties": false,
      "properties": {
        "component_manifest_schema": {
          "const": "ribon-boot-module-components-v1"
        },
        "maximum_modules": {"const": 8},
        "provider": {"const": "generated-component-bundle-v1"}
      }
    },
    "update_storage": {
      "type": "object",
      "required": [
        "schema",
        "provider_class",
        "layout_id",
        "layout_digest_sha256",
        "read_service_id",
        "writer_service_id",
        "metadata_service_id",
        "flush_service_id"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "ribon-update-storage-binding-v1"},
        "provider_class": {"enum": ["firmware", "native", "reference"]},
        "layout_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "layout_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "read_service_id": {"type": "string", "minLength": 1},
        "writer_service_id": {"type": "string", "minLength": 1},
        "metadata_service_id": {"type": "string", "minLength": 1},
        "flush_service_id": {"type": "string", "minLength": 1}
      }
    },
    "signature_provider": {
      "type": "object",
      "required": ["algorithm", "class", "id", "symbol"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {"const": "ed25519"},
        "class": {"enum": ["production", "fixture"]},
        "id": {"type": "string", "pattern": "^security\\.signature\\."},
        "symbol": {"type": "string", "pattern": "^ribon_"}
      }
    },
    "protected_state_provider": {
      "type": "object",
      "required": ["class", "id", "rollback_domains", "symbol"],
      "additionalProperties": false,
      "properties": {
        "class": {"enum": ["hardware", "reference", "fixture"]},
        "id": {"type": "string", "pattern": "^security\\.protected-state\\."},
        "rollback_domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "symbol": {"type": "string", "pattern": "^ribon_"}
      }
    },
    "key_policy": {
      "type": "object",
      "required": ["generation", "id", "keys"],
      "additionalProperties": false,
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "id",
              "issuer",
              "maximum_sequence",
              "minimum_sequence",
              "modes",
              "public_key_hex",
              "rollback_domains",
              "status",
              "usages"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
              },
              "issuer": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                  },
                  {"type": "null"}
                ]
              },
              "maximum_sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "minimum_sequence": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "modes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "diagnostic",
                    "normal",
                    "provisioning",
                    "recovery"
                  ]
                }
              },
              "public_key_hex": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "rollback_domains": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "maxLength": 128}
              },
              "status": {"enum": ["active", "retiring", "revoked"]},
              "usages": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "boot-image",
                    "policy-diagnostic",
                    "policy-normal",
                    "policy-provisioning",
                    "policy-recovery",
                    "update-manifest"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "ribos_policy": {
      "type": "object",
      "required": [
        "policy_id",
        "schema_symbol",
        "authorization",
        "factory_recovery_symbol",
        "validate_boot_action_symbol",
        "timer_service_id",
        "watchdog_service_id",
        "watchdog_required",
        "phase",
        "capabilities",
        "ribon_capabilities",
        "arena_budget",
        "limits",
        "helpers"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "schema_symbol": {"type": "string", "pattern": "^ribos_"},
        "authorization": {
          "type": "object",
          "required": ["class", "callback_symbol", "rollback_domain"],
          "properties": {
            "class": {"enum": ["fixture-callback", "signed-policy"]},
            "callback_symbol": {
              "oneOf": [
                {"type": "string", "pattern": "^ribon_"},
                {"type": "null"}
              ]
            },
            "rollback_domain": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {"type": "null"}
              ]
            }
          },
          "additionalProperties": false
        },
        "factory_recovery_symbol": {"type": "string", "pattern": "^ribon_"},
        "validate_boot_action_symbol": {"type": "string", "pattern": "^ribon_"},
        "timer_service_id": {"type": "string", "minLength": 1},
        "watchdog_service_id": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "watchdog_required": {"type": "boolean"},
        "phase": {"const": "boot"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BOOT",
              "DEVICE",
              "DIAGNOSTIC",
              "FLASH",
              "HANDOFF",
              "INSPECT",
              "NETWORK",
              "STATE"
            ]
          }
        },
        "ribon_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "arena_budget": {"type": "integer", "minimum": 1},
        "limits": {
          "type": "object",
          "required": [
            "maximum_instructions",
            "maximum_helper_calls",
            "maximum_stack_bytes",
            "maximum_arena_bytes",
            "maximum_input_bytes",
            "maximum_output_bytes",
            "maximum_operations",
            "maximum_polls",
            "maximum_execution_duration_ns",
            "maximum_helper_duration_ns",
            "maximum_call_depth",
            "maximum_handles",
            "maximum_trace_records"
          ],
          "additionalProperties": false,
          "properties": {
            "maximum_instructions": {"type": "integer", "minimum": 1},
            "maximum_helper_calls": {"type": "integer", "minimum": 1},
            "maximum_stack_bytes": {"type": "integer", "minimum": 1},
            "maximum_arena_bytes": {"type": "integer", "minimum": 1},
            "maximum_input_bytes": {"type": "integer", "minimum": 1},
            "maximum_output_bytes": {"type": "integer", "minimum": 1},
            "maximum_operations": {"type": "integer", "minimum": 1},
            "maximum_polls": {"type": "integer", "minimum": 1},
            "maximum_execution_duration_ns": {"type": "integer", "minimum": 1},
            "maximum_helper_duration_ns": {"type": "integer", "minimum": 1},
            "maximum_call_depth": {"type": "integer", "minimum": 1},
            "maximum_handles": {"type": "integer", "minimum": 1},
            "maximum_trace_records": {"type": "integer", "minimum": 1}
          }
        },
        "helpers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": [
              "stable_id",
              "callback_symbol",
              "service_kind",
              "service_id",
              "ribon_capabilities",
              "ribos_capabilities",
              "effect",
              "durability",
              "handle_transition",
              "transition_parameter",
              "allowed_modes",
              "allowed_phases",
              "maximum_input_bytes",
              "maximum_output_bytes",
              "maximum_operations",
              "maximum_polls",
              "maximum_duration_ns"
            ],
            "additionalProperties": false,
            "properties": {
              "stable_id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967294
              },
              "callback_symbol": {"type": "string", "pattern": "^ribon_"},
              "service_kind": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "null"}
                ]
              },
              "service_id": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "null"}
                ]
              },
              "ribon_capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "ribos_capabilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "effect": {
                "enum": ["pure", "ephemeral", "journaled", "terminal"]
              },
              "durability": {
                "enum": [
                  "none",
                  "volatile",
                  "journal-receipt",
                  "sealed-intent"
                ]
              },
              "handle_transition": {
                "enum": [
                  "none",
                  "create",
                  "consume",
                  "replace",
                  "terminal-consume"
                ]
              },
              "transition_parameter": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "allowed_modes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "normal",
                    "recovery",
                    "provisioning",
                    "diagnostic"
                  ]
                }
              },
              "allowed_phases": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "early",
                    "foundation",
                    "driver",
                    "boot",
                    "quiesce"
                  ]
                }
              },
              "maximum_input_bytes": {"type": "integer", "minimum": 1},
              "maximum_output_bytes": {"type": "integer", "minimum": 1},
              "maximum_operations": {"type": "integer", "minimum": 1},
              "maximum_polls": {"type": "integer", "minimum": 1},
              "maximum_duration_ns": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "max_plugins": {"type": "integer", "minimum": 1, "maximum": 64},
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "symbol"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1}
        }
      }
    },
    "service_selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "plugin_selections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "allowed_capabilities": {"type": "array", "items": {"type": "string"}},
    "limits": {"type": "object"},
    "plugins": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
