{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ribon.dev/schema/plugin-package-v1.json",
  "title": "Ribon plugin package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "plugin_id",
    "plugin_kind",
    "sdk_abi",
    "public_headers",
    "sources",
    "tests",
    "documentation",
    "qstar_file"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"type": "string", "minLength": 1},
    "plugin_id": {"type": "string", "minLength": 1},
    "plugin_kind": {"type": "string", "minLength": 1},
    "sdk_abi": {"const": 5},
    "public_headers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "documentation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "qstar_file": {"type": "string", "minLength": 1}
  }
}
