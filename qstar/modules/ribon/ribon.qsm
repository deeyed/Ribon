local M = {}

local host_arches = {
  "x86_64",
  "aarch64",
  "riscv64",
}

local uefi_variants = {
  "x64",
  "aa64",
}

local uefi_contexts = {
  x64 = {
    arch = "x86_64",
    boot_file = "BOOTX64.EFI",
    binding_dir = "X64",
  },
  aa64 = {
    arch = "aarch64",
    boot_file = "BOOTAA64.EFI",
    binding_dir = "AArch64",
  },
}

local rpi_variants = {
  "rpi5",
  "qemu_virt",
}

local rpi_contexts = {
  rpi5 = {
    name = "rpi5",
    board_kind = "RIBON_RPI_BOARD_RPI5",
    cpu = "cortex-a76",
    kernel_alias = "ribon-rpi5.img",
    kernel_load_base = "0x00200000",
    load_address = "0x00080000",
    payload_artifact_name = "ribon-rpi5.elf",
    platform_name = "rpi5",
    ram_base = "0x00000000",
    ram_size = "0x10000000",
    uart_base = "0x107d001000",
  },
  qemu_virt = {
    name = "rpi-qemu-virt",
    board_kind = "RIBON_RPI_BOARD_QEMU_VIRT",
    cpu = "cortex-a72",
    kernel_alias = "ribon-rpi5.img",
    kernel_load_base = "0x40200000",
    load_address = "0x40080000",
    payload_artifact_name = "ribon-rpi-qemu.elf",
    platform_name = "qemu-virt",
    ram_base = "0x40000000",
    ram_size = "0x10000000",
    uart_base = "0x09000000",
  },
}

local function require_uefi_context(variant)
  local context = uefi_contexts[variant]
  if not context then
    error("unknown UEFI variant '" .. tostring(variant) .. "'")
  end
  return context
end

local function require_rpi_context(variant)
  local context = rpi_contexts[variant]
  if not context then
    error("unknown RPi variant '" .. tostring(variant) .. "'")
  end
  return context
end

function M.host_arches()
  return qstar.copy(host_arches)
end

function M.uefi_variants()
  return qstar.copy(uefi_variants)
end

function M.uefi_arch(variant)
  return require_uefi_context(variant).arch
end

function M.uefi_boot_file(variant)
  return require_uefi_context(variant).boot_file
end

function M.uefi_binding_dir(variant)
  return require_uefi_context(variant).binding_dir
end

function M.uefi_include_dirs(variant)
  return {
    "include/freestanding",
    qstar.join("include/uefi", M.uefi_binding_dir(variant)),
    "include/uefi",
    "include",
  }
end

function M.uefi_c_compile_options(variant)
  if M.uefi_arch(variant) == "x86_64" then
    return {
      "-mno-red-zone",
      "-mno-stack-arg-probe",
    }
  end
  return {}
end

function M.uefi_fixture_arch(variant)
  return M.uefi_arch(variant)
end

function M.uefi_fixture_path(variant)
  return qstar.join("build/qstar/generated/uefi", M.uefi_arch(variant), "kernel/kernel.elf")
end

function M.uefi_stage_root(variant)
  return qstar.join("build/qstar/stage/uefi", M.uefi_arch(variant))
end

function M.rpi_variants()
  return qstar.copy(rpi_variants)
end

function M.rpi_context(variant)
  return qstar.copy(require_rpi_context(variant))
end

function M.rpi_generated_dir(variant)
  return qstar.join("build/qstar/generated", require_rpi_context(variant).name)
end

function M.rpi_kernel_fixture_path(variant)
  return qstar.join(M.rpi_generated_dir(variant), "kernel/kernel.elf")
end

function M.rpi_payload_embed_object_path(variant)
  return qstar.join(M.rpi_generated_dir(variant), "obj/rpi_payload_embed.o")
end

function M.rpi_image_path(variant)
  return qstar.join(M.rpi_generated_dir(variant), "kernel8.img")
end

function M.rpi_stage_root(variant)
  return qstar.join("build/qstar/stage", require_rpi_context(variant).name)
end

function M.rpi_cmdline_path()
  return "configs/rpi5/cmdline.txt"
end

function M.rpi_config_path()
  return "configs/rpi5/config.txt"
end

function M.rpi_fixture_base(variant)
  return require_rpi_context(variant).kernel_load_base
end

function M.rpi_payload_artifact_name(variant)
  return require_rpi_context(variant).payload_artifact_name
end

function M.rpi_clang_target_options(variant)
  return {
    "-target",
    "aarch64-none-elf",
    "-mcpu=" .. require_rpi_context(variant).cpu,
  }
end

function M.rpi_defsym_link_options(variant)
  return {
    "--defsym=RIBON_RPI_LOAD_ADDRESS=" .. require_rpi_context(variant).load_address,
  }
end

function M.rpi_c_compile_options(variant)
  local profile = require_rpi_context(variant)
  return {
    "-DRIBON_RPI_UART_BASE=" .. profile.uart_base,
    "-DRIBON_RPI_BOARD_KIND=" .. profile.board_kind,
    "-DRIBON_RPI_PLATFORM_NAME=\"" .. profile.platform_name .. "\"",
    "-DRIBON_RPI_KERNEL_ELF_PATH=\"" .. M.rpi_kernel_fixture_path(variant) .. "\"",
    "-DRIBON_RPI_CMDLINE_PATH=\"" .. M.rpi_cmdline_path() .. "\"",
    "-DRIBON_RPI_ENABLE_KERNEL_JUMP=0",
    "-DRIBON_RPI_RAM_BASE=" .. profile.ram_base,
    "-DRIBON_RPI_RAM_SIZE=" .. profile.ram_size,
  }
end

function M.rpi_payload_embed_compile_options(variant)
  return {
    "-DRIBON_RPI_KERNEL_ELF_PATH=\"" .. M.rpi_kernel_fixture_path(variant) .. "\"",
    "-DRIBON_RPI_CMDLINE_PATH=\"" .. M.rpi_cmdline_path() .. "\"",
  }
end

return M
